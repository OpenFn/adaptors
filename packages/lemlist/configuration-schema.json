{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "apiKey": {
      "title": "API Key",
      "type": "string",
      "description": "Your lemlist API key (Settings > Integrations)",
      "writeOnly": true,
      "minLength": 1,
      "examples": ["a1b2c3d4e5f6"]
    },
    "baseUrl": {
      "title": "Base URL",
      "type": "string",
      "description": "Override the lemlist API base URL. Defaults to https://api.lemlist.com/api",
      "format": "uri",
      "examples": ["https://api.lemlist.com/api"]
    }
  },
  "type": "object",
  "additionalProperties": true,
  "required": ["apiKey"]
}
