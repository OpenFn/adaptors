{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "baseUrl": {
      "title": "Base URL",
      "type": "string",
      "description": "The base URL of the BDR API (e.g., https://bdrbeta.npontu.com)",
      "format": "uri",
      "minLength": 1,
      "examples": ["https://bdrbeta.npontu.com"]
    },
    "token": {
      "title": "API Token",
      "type": "string",
      "description": "Long-lived API consumer token for authentication",
      "writeOnly": true,
      "minLength": 1,
      "examples": ["your-long-lived-api-token-here"]
    }
  },
  "type": "object",
  "additionalProperties": true,
  "required": ["baseUrl", "token"]
}
