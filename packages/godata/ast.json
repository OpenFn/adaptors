        "id",
        "externalId",
        "goDataContact"
      ],
      "docs": {
        "description": "Upsert a contact within an outbreak. Looks up the contact whose `externalId` field\nmatches the value of that field on `goDataContact`. Creates the contact if none match,\nupdates it if one matches, and throws if more than one matches.\nOn update, send only the fields you want to change.",
        "tags": [
          {
            "title": "public",
            "description": null,
            "type": null
          },
          {
            "title": "example",
            "description": "upsertContact('4dce-3eedce3-rd33', 'visualId', {\n  visualId: 'CON-0001',\n  firstName: 'Luca',\n  gender: 'male',\n  'age:years': '20',\n});"
          },
          {
            "title": "function",
            "description": null,
            "name": null
          },
          {
            "title": "param",
            "description": "Outbreak id",
