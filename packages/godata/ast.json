    {
      "name": "upsertCase",
      "params": [
        "id",
        "externalId",
        "goDataCase"
      ],
      "docs": {
        "description": "Upsert a case within an outbreak. Looks up the case whose `externalId` field\nmatches the value of that field on `goDataCase`. Creates the case if none match,\nupdates it if one matches, and throws if more than one matches.\nOn update, the matched case's `id` is added to the body and `visualId` is removed.\nSend only the fields you want to change.",
        "tags": [
          {
            "title": "public",
            "description": null,
            "type": null
          },
          {
            "title": "example",
            "description": "upsertCase('4dce-3eedce3-rd33', 'visualId', $ => ({\n  firstName: $.data.firstName,\n  lastName: $.data.lastName,\n  visualId: $.data.caseId,\n  'age:years': $.data.age,\n  gender: $.data.sex,\n}));"
          },
          {
            "title": "function",
            "description": null,
            "name": null
          },
          {
            "title": "param",
            "description": "Outbreak id",
            "type": {
              "type": "NameExpression",
              "name": "string"
            },
            "name": "id"
          },
          {
            "title": "param",
            "description": "Match field: the case property used to find an existing case, e.g. `visualId`",
            "type": {
              "type": "NameExpression",
              "name": "string"
            },
            "name": "externalId"
          },
          {
            "title": "param",
