{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Service Account",
  "properties": {
    "private_key": {
      "title": "Private Key",
      "type": "string",
      "description": "RSA private key from the Google service account JSON key file",
      "writeOnly": true,
      "minLength": 1,
      "examples": ["-----BEGIN RSA PRIVATE KEY-----\nMIIEow..."]
    },
    "client_email": {
      "title": "Client Email",
      "type": "string",
      "description": "Service account email address (e.g. my-app@project-id.iam.gserviceaccount.com)",
      "minLength": 1,
      "examples": ["my-app@project-id.iam.gserviceaccount.com"]
    }
  },
  "type": "object",
  "additionalProperties": true,
  "required": ["private_key", "client_email"]
}
