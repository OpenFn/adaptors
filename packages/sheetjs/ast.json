    {
      "name": "jsonToSheet",
      "params": [
        "data",
        "options"
      ],
      "docs": {
        "description": "Build a spreadsheet file from an array of objects.\n\nWrites `{ buffer, bookType, sheetName }` to `state.data` - or\n`{ base64, ... }` with `output: 'base64'` - ready for an `http`, `sftp` or\n`googledrive` step to upload.\n\nColumn headers come from the keys of the data; pass `header` to fix their\norder. Values are always written as text, never formulas, but CSV has no\ncell types - sanitise untrusted data before writing a CSV someone will open\nin a spreadsheet app.",
        "tags": [
          {
            "title": "public",
            "description": null,
            "type": null
          },
          {
            "title": "example",
            "description": "jsonToSheet($.data.records, { sheetName: 'Export' });",
            "caption": "Build an xlsx buffer from records on state"
          },
          {
            "title": "example",
            "description": "jsonToSheet($.data.records, { sheetName: 'Export', output: 'base64' });",
            "caption": "Build a base64 xlsx file, ready to upload"
          },
          {
            "title": "example",
            "description": "jsonToSheet($.data.records, {\n  bookType: 'csv',\n  header: ['id', 'name', 'dateOfBirth'],\n});",
            "caption": "Write a CSV file with a fixed column order"
          },
          {
            "title": "function",
            "description": null,
            "name": null
          },
          {
            "title": "param",
            "description": "An array of objects, one per row",
            "type": {
              "type": "TypeApplication",
              "expression": {
                "type": "NameExpression",
                "name": "Array"
              },
              "applications": [
                {
                  "type": "NameExpression",
                  "name": "object"
                }
              ]
            },
            "name": "data"
          },
          {
            "title": "param",
            "description": "Optional write options",
            "type": {
              "type": "NameExpression",
              "name": "JsonToSheetOptions"
            },
            "name": "options"
          },
          {
            "title": "state",
            "description": "{SheetjsState}"
          },
          {
            "title": "returns",
            "description": null,
            "type": {
              "type": "NameExpression",
              "name": "Operation"
            }
          }
        ]
      },
      "valid": true
    }
