{
  "operations": [
    {
      "name": "parse",
      "params": [
        "content",
        "options"
      ],
      "docs": {
        "description": "Parse spreadsheet file content into a workbook.\n\nWrites `{ sheetNames }` to `state.data`. The workbook itself is held in\nmemory for the rest of the job, so `sheetToJson()` and `sheetToCsv()` can\nread it without re-parsing the file.\n\nHandles `.xlsx`, `.xls`, `.csv` and every other format SheetJS supports.\nBuffers, base64 strings and data URLs are detected automatically - pass\n`type` to override, eg for a single-column CSV that is also valid base64.",
        "tags": [
          {
            "title": "public",
            "description": null,
            "type": null
          },
          {
            "title": "example",
            "description": "parse($.data.fileContent);",
            "caption": "Parse a base64 file fetched by a previous step"
          },
          {
            "title": "example",
            "description": "parse($.data.fileContent, { type: 'base64' });",
            "caption": "Declare the content type explicitly"
          },
          {
            "title": "example",
            "description": "parse($.data.fileContent, { cellDates: false });",
            "caption": "Keep Excel date serial numbers instead of Date objects"
          },
          {
            "title": "function",
            "description": null,
            "name": null
          },
          {
            "title": "param",
            "description": "The file content to parse",
            "type": {
              "type": "NameExpression",
              "name": "FileContent"
            },
            "name": "content"
          },
          {
            "title": "param",
            "description": "Optional parse options",
            "type": {
              "type": "NameExpression",
              "name": "ParseOptions"
            },
            "name": "options"
          },
          {
            "title": "state",
            "description": "{SheetjsState}"
          },
          {
            "title": "returns",
            "description": null,
            "type": {
              "type": "NameExpression",
              "name": "Operation"
            }
          }
        ]
      },
      "valid": true
    },
    {
      "name": "sheetToJson",
      "params": [
        "content",
        "options"
      ],
      "docs": {
        "description": "Convert a worksheet into an array of objects, one per row, and write it to\n`state.data`.\n\nPass file content to convert it directly, or `null` to reuse the workbook\nfrom an earlier `parse()` and skip re-parsing the file.\n\nReads the first sheet unless `sheetName` or `sheetIndex` says otherwise.",
        "tags": [
          {
            "title": "public",
            "description": null,
            "type": null
          },
          {
            "title": "example",
            "description": "sheetToJson($.data.fileContent);",
            "caption": "Convert the first sheet of a file to JSON"
          },
          {
            "title": "example",
            "description": "parse($.data.fileContent);\nsheetToJson(null, { sheetName: 'Sheet1', raw: false });",
            "caption": "Convert a named sheet from an earlier parse()"
          },
          {
            "title": "example",
            "description": "sheetToJson($.data.fileContent, { header: 1 });",
            "caption": "Return rows as arrays of cell values instead of objects"
          },
          {
            "title": "example",
            "description": "sheetToJson($.data.fileContent, { range: 'A2:D40', defval: null });",
            "caption": "Only read a fixed range, and fill empty cells"
          },
          {
            "title": "function",
            "description": null,
            "name": null
          },
          {
            "title": "param",
            "description": "File content to convert, or `null` to reuse an earlier `parse()`",
            "type": {
              "type": "NameExpression",
              "name": "FileContent"
            },
            "name": "content"
          },
          {
            "title": "param",
            "description": "Optional conversion options",
            "type": {
              "type": "NameExpression",
              "name": "SheetToJsonOptions"
            },
            "name": "options"
          },
          {
            "title": "state",
            "description": "{SheetjsState}"
          },
          {
            "title": "returns",
            "description": null,
            "type": {
              "type": "NameExpression",
              "name": "Operation"
            }
          }
        ]
      },
      "valid": true
    },
