    {
      "name": "toDhis2DataValues",
      "params": [
        "measurements",
        "mappingConfig",
        "options"
      ],
      "docs": {
        "description": "DHIS2-specific convenience: map AirQo measurements into DHIS2 `dataValue`\r\nentries for batch import. This does not call the AirQo or DHIS2 APIs — it's\r\na pure data-shaping step. If your workflow targets a different system,\r\nwrite your own mapping in job code instead of using this operation.\r\n\r\nThis operation is designed for scheduled workflows where measurements are\r\nfetched first (for example via getAllHistoricalMeasurements) and then mapped\r\nto DHIS2 org units and data elements.",
        "tags": [
          {
            "title": "example",
            "description": "toDhis2DataValues(\r\n  state => state.data.measurements,\r\n  {\r\n    orgUnits: {\r\n      site_id_001: 'DHIS2_ORG_UNIT_UID_1',\r\n    },\r\n    dataElements: {\r\n      pm2_5: 'DHIS2_PM25_ELEMENT_UID',\r\n      pm10: 'DHIS2_PM10_ELEMENT_UID',\r\n    },\r\n  },\r\n  { fields: ['pm2_5', 'pm10'], periodType: 'daily' }\r\n);",
            "caption": "Transform PM2.5 and PM10 measurements into daily data values"
          },
          {
            "title": "function",
            "description": null,
            "name": null
          },
          {
            "title": "public",
            "description": null,
            "type": null
          },
          {
            "title": "param",
            "description": "Array of measurements or a state-resolved reference to one",
            "type": {
              "type": "UnionType",
              "elements": [
                {
                  "type": "TypeApplication",
                  "expression": {
                    "type": "NameExpression",
                    "name": "Array"
                  },
                  "applications": [
                    {
                      "type": "NameExpression",
                      "name": "AirQoMeasurement"
                    }
                  ]
                },
                {
                  "type": "NameExpression",
                  "name": "function"
                }
              ]
            },
            "name": "measurements"
          },
          {
            "title": "param",
            "description": "Mapping config containing `orgUnits` and `dataElements`",
            "type": {
              "type": "UnionType",
              "elements": [
                {
                  "type": "NameExpression",
                  "name": "object"
                },
                {
                  "type": "NameExpression",
                  "name": "function"
                }
              ]
            },
            "name": "mappingConfig"
          },
          {
            "title": "param",
            "description": "Transform options: `fields` and `periodType`",
            "type": {
              "type": "OptionalType",
              "expression": {
                "type": "NameExpression",
                "name": "object"
              }
            },
            "name": "options"
          },
          {
            "title": "returns",
            "description": null,
            "type": {
              "type": "NameExpression",
              "name": "Operation"
            }
          },
          {
            "title": "state",
            "description": "{object} data - Object containing `dataValues` array and a `summary`"
          }
        ]
      },
      "valid": true
    },
