    {
      "name": "listMetadata",
      "params": [
        "resource",
        "params"
      ],
      "docs": {
        "description": "Retrieve metadata about publicly available AirQo monitoring entities.\r\n\r\nValid `resource` values:\r\n- `'grids'`   — all publicly available geographic grids\r\n- `'cohorts'` — all publicly available device cohorts\r\n- `'devices'` — all publicly available devices\r\n- `'sites'`   — all publicly available monitoring sites",
        "tags": [
          {
            "title": "example",
            "description": "listMetadata('sites');",
            "caption": "Get all publicly available sites"
          },
