{
  "operations": [
    {
      "name": "getRecentMeasurements",
      "params": [
        "entityType",
        "entityId",
        "params"
      ],
      "docs": {
        "description": "Retrieve the most recent air quality measurements for a monitoring entity.\r\n\r\nThe `entityType` determines which kind of entity is queried. Valid values are:\r\n- `'sites'`   — a single monitoring site\r\n- `'devices'` — a specific sensor device\r\n- `'grids'`   — a named geographic grid (e.g. a city or country)\r\n- `'cohorts'` — a user-defined group of devices",
        "tags": [
          {
            "title": "example",
            "description": "getRecentMeasurements('sites', '60d058c8048305120d######');",
            "caption": "Get recent measurements for a site"
          },
          {
            "title": "example",
            "description": "getRecentMeasurements('grids', '65e98e11528c9f00133444f8');",
            "caption": "Get recent measurements for a grid"
          },
          {
            "title": "example",
            "description": "getRecentMeasurements('devices', '5f2036bc70223655545#####');",
            "caption": "Get recent measurements for a device"
          },
          {
            "title": "function",
            "description": null,
            "name": null
          },
          {
            "title": "public",
            "description": null,
            "type": null
          },
          {
            "title": "param",
            "description": "Type of entity: 'sites' | 'devices' | 'grids' | 'cohorts'",
            "type": {
              "type": "NameExpression",
              "name": "string"
            },
            "name": "entityType"
          },
          {
            "title": "param",
            "description": "The ID of the entity to retrieve measurements for",
            "type": {
              "type": "NameExpression",
              "name": "string"
            },
            "name": "entityId"
          },
          {
            "title": "param",
            "description": "Optional query parameters passed through to AirQo (e.g. { limit: 100 })",
            "type": {
              "type": "OptionalType",
              "expression": {
                "type": "NameExpression",
                "name": "object"
              }
            },
            "name": "params"
          },
          {
            "title": "returns",
            "description": null,
            "type": {
              "type": "NameExpression",
              "name": "Operation"
            }
          },
          {
            "title": "state",
            "description": "{AirQoState} data - Object containing `measurements` array and `meta` pagination info"
          }
        ]
      },
      "valid": true
    },
    {
      "name": "getHistoricalMeasurements",
      "params": [
        "entityType",
        "entityId",
        "params"
      ],
      "docs": {
        "description": "Retrieve historical (past) air quality measurements for a monitoring entity.\r\n\r\nThe `entityType` determines which kind of entity is queried. Valid values are:\r\n- `'sites'`   — a single monitoring site\r\n- `'devices'` — a specific sensor device\r\n- `'grids'`   — a named geographic grid (e.g. a city or country)\r\n- `'cohorts'` — a user-defined group of devices",
        "tags": [
          {
            "title": "example",
            "description": "getHistoricalMeasurements('sites', '60d058c8048305120d######');",
            "caption": "Get historical measurements for a site"
          },
          {
            "title": "example",
            "description": "getHistoricalMeasurements('grids', '65e98e11528c9f00133444f8', {\r\n  startTime: '2024-01-01T00:00:00Z',\r\n  endTime: '2024-01-31T23:59:59Z',\r\n});",
            "caption": "Get historical measurements for a grid with date range"
          },
