    {
      "name": "getAllHistoricalMeasurements",
      "params": [
        "entityType",
        "entityId",
        "params"
      ],
      "docs": {
        "description": "Retrieve ALL historical air quality measurements for a monitoring entity,\r\nautomatically fetching every page of results and combining them into a\r\nsingle `measurements` array.\r\n\r\nUse this instead of `getHistoricalMeasurements` when you need a complete\r\ndataset and the total number of records may exceed one page (1000 records).",
        "tags": [
          {
            "title": "example",
            "description": "getAllHistoricalMeasurements('sites', '60d058c8048305120d######');",
            "caption": "Get all historical measurements for a site"
          },
          {
            "title": "example",
            "description": "getAllHistoricalMeasurements('grids', '65e98e11528c9f00133444f8', {\r\n  startTime: '2024-01-01T00:00:00Z',\r\n  endTime: '2024-01-31T23:59:59Z',\r\n});",
            "caption": "Get all historical measurements for a grid with a date range"
          },
          {
            "title": "function",
            "description": null,
            "name": null
          },
          {
            "title": "public",
            "description": null,
            "type": null
          },
          {
            "title": "param",
            "description": "Type of entity: 'sites' | 'devices' | 'grids' | 'cohorts'",
            "type": {
              "type": "NameExpression",
              "name": "string"
            },
            "name": "entityType"
          },
          {
            "title": "param",
            "description": "The ID of the entity to retrieve measurements for",
            "type": {
              "type": "NameExpression",
              "name": "string"
            },
            "name": "entityId"
          },
          {
            "title": "param",
            "description": "Optional query parameters passed through to AirQo (e.g. { startTime, endTime }). Do not pass `limit`.",
            "type": {
              "type": "OptionalType",
              "expression": {
                "type": "NameExpression",
                "name": "object"
              }
            },
            "name": "params"
          },
          {
            "title": "returns",
            "description": null,
            "type": {
              "type": "NameExpression",
              "name": "Operation"
            }
          },
          {
            "title": "state",
            "description": "{AirQoState} data - Object containing combined `measurements` array and `meta` from the last page"
          }
