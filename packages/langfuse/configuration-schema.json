{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "baseUrl": {
      "title": "Base URL",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The Langfuse base URL",
      "format": "uri",
      "minLength": 1,
      "default": "https://api.langfuse.com",
      "examples": ["https://cloud.langfuse.com"]
    },
    "publicKey": {
      "title": "Public Key",
      "type": "string",
      "description": "Langfuse public key",
      "examples": ["pk-lf-520nu7h342-gh45-g4rf34-54gg34r"]
    },
    "secretKey": {
      "title": "Secret Key",
      "type": "string",
      "description": "Langfuse secret key",
      "writeOnly": true,
      "examples": ["sk-lf-520nu7h342-gh45-g4rf34-54gg34r"]
    }
  },
  "type": "object",
  "additionalProperties": true,
  "required": ["publicKey", "secretKey"]
}
